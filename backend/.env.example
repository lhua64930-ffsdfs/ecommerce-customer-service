# ============ 应用 ============
PROJECT_NAME=售后智答
VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ============ 数据库 ============
DATABASE_URL=mysql+aiomysql://cs_user:cs_password@127.0.0.1:3306/customer_service?charset=utf8mb4
# 留空=不启用 Redis:限流走进程内存,转人工只落 DB;配置后启用 Redis 限流/排队
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_RETRY_COOLDOWN_SECONDS=30

# ============ LLM(DeepSeek,OpenAI 兼容) ============
# provider: deepseek | openai | mock(无 key 时自动降级为 mock)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ============ Embedding(本地 BGE 中文模型) ============
EMBEDDING_PROVIDER=local
# 远程模式(OpenAI 兼容,如 SiliconFlow):provider=openai 并填 API 地址/Key
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 国内模型下载镜像
HF_ENDPOINT=https://hf-mirror.com

# ============ Milvus 向量数据库 ============
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_base
# 向量检索失败后的降级冷却时间(秒),避免持续重试宕机服务
RAG_VECTOR_RETRY_SECONDS=30

# ============ RAG 2.0 检索 ============
# vector | bm25 | hybrid | hybrid_rerank
RAG_RETRIEVAL_STRATEGY=hybrid_rerank
RAG_RECALL_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_ENABLED=true
# local=本地 CrossEncoder;openai=OpenAI 兼容 rerank API(如 SiliconFlow)
RERANK_PROVIDER=local
RERANK_API_BASE=
RERANK_API_KEY=
# 证据置信度阈值(低于该值拒答/转人工)
RAG_EVIDENCE_THRESHOLD=0.5
RAG_SELF_CHECK=true
RAG_SUBQUERY_SPLIT=true
RAG_QUERY_EXPANSION=true

# ============ 安全认证 ============
# false=本地演示兼容;true=保护 /api/v1/*(登录/注册放行)
AUTH_ENABLED=false
# 短信/扫码登录(console 只写日志;生产可接短信网关)
SMS_PROVIDER=console
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_SECONDS=60
SMS_DEBUG_RETURN_CODE=false
QR_LOGIN_TTL_SECONDS=120
JWT_SECRET_KEY=please-change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 限流 / 会话 ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# 突发额度:容量 = 每分钟额度 + burst
RATE_LIMIT_BURST=0
# auto=有 REDIS_URL 用 Redis,否则内存;memory=强制内存;redis=强制 Redis
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_MAX_KEYS=10000
# 可选:按客户端 IP 的全局限流中间件(聊天接口已有按会话限流)
RATE_LIMIT_MIDDLEWARE_ENABLED=false
SESSION_TTL_SECONDS=86400

# ============ 上游熔断 ============
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

# ============ 确定性路由图 ============
# true 时走 coref → intent → 分支 → finalize;异常自动回退旧链路
GRAPH_ORCHESTRATOR_ENABLED=true

# ============ LangGraph Checkpointer ============
# none / memory / sqlite / postgres(多副本需额外 DSN)
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_DB_PATH=data/checkpoints.sqlite
CHECKPOINTER_POSTGRES_URL=
CHECKPOINT_TTL_HOURS=24

# ============ 会话上下文 ============
SUMMARY_TRIGGER_MESSAGES=16
SEMANTIC_HISTORY_ENABLED=false
SEMANTIC_HISTORY_TOP_K=3
SEMANTIC_HISTORY_MAX_CANDIDATES=100
SEMANTIC_HISTORY_MIN_SCORE=0.35
SEMANTIC_HISTORY_MAX_CHARS=600

# ============ 数据保留期(0=永久保留) ============
RETENTION_ENABLED=false
RETENTION_DAYS_MESSAGES=0
RETENTION_DAYS_SESSIONS=0
RETENTION_DAYS_LOW_CONF=0
RETENTION_DAYS_AGENT_RUNS=0
RETENTION_DAYS_AUDIT=0
RETENTION_BATCH_SIZE=500
RETENTION_KEEP_PENDING_LOW_CONF=true

# ============ Skills 运维指令包(可选) ============
# true 时按意图加载 backend/skills/*.md 并追加到系统提示词
SKILLS_ENABLED=false
SKILLS_DIR=skills
SKILLS_MAX_CHARS=1500

# ============ MCP 工具服务化(可选) ============
# true 时 Agent 工具通过独立 MCP Server 调用;本地未启动 MCP 时自动回退进程内工具
MCP_ENABLED=false
# 多 Server:知识/商品、订单/售后
MCP_KNOWLEDGE_URL=http://127.0.0.1:8001/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8002/mcp
# 本地默认只监听回环;Docker 中由 compose 覆盖为 0.0.0.0
MCP_SERVER_HOST=127.0.0.1
MCP_KNOWLEDGE_PORT=8001
MCP_AFTERSALES_PORT=8002
MCP_TIMEOUT=45
# 动态拉取工具清单(Server 加工具无需重启后端)与缓存时间
MCP_DYNAMIC_TOOLS=true
MCP_DISCOVERY_TIMEOUT=5
MCP_TOOL_CACHE_TTL=60
# 仅幂等只读工具会在 MCP 传输失败时回退本地
MCP_FALLBACK_TO_LOCAL=true

# ============ 可观测(可选) ============
# 三项都配置后启用 Langfuse;否则完全 no-op
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
