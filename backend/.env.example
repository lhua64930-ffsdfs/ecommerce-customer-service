# ============ 应用 ============
PROJECT_NAME=电商智能客服系统
VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ============ 数据库 ============
DATABASE_URL=mysql+aiomysql://cs_user:cs_password@127.0.0.1:3306/customer_service?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# ============ LLM(DeepSeek,OpenAI 兼容) ============
# provider: deepseek | openai | mock(无 key 时自动降级为 mock)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ============ Embedding(本地 BGE 中文模型) ============
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 国内模型下载镜像
HF_ENDPOINT=https://hf-mirror.com

# ============ Milvus 向量数据库 ============
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_base

# ============ 安全认证 ============
JWT_SECRET_KEY=please-change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 限流 / 会话 ============
RATE_LIMIT_PER_MINUTE=60
SESSION_TTL_SECONDS=86400
